{
  "manifest_version": 3,
  "name": "Open in Brave",
  "version": "1.0.0",
  "description": "Right-click a link or page, or click the toolbar icon, to open the link / current tab in the Brave browser.",
  "key": "",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "activeTab"
  ],
  "action": {
    "default_title": "Open in Brave",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
